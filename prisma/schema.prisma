// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Recipe {
  id              Int      @id @default(autoincrement())
  recipeName      String
  servings        String
  description     String
  ingredients     String[] // Array of ingredient strings
  procedure       String
  estimatedTime   String
  calories        String
  nutritionalInfo Json
  vegan           Boolean
  categories      String[]
  createdAt       DateTime @default(now())
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  password        String // hashed password
  profileImageUrl String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userRecipes     userRecipes[]
  UserIngredient  UserIngredient[]
}

model UserIngredient {
  id                Int                 @id @default(autoincrement())
  userId            String
  user              User                @relation(fields: [userId], references: [id])
  Vegetable         Vegetable[]
  Fruit             Fruit[]
  Meat              Meat[]
  PlantBasedProtein PlantBasedProtein[]
  DairyEgg          DairyEgg[]
  GrainCereal       GrainCereal[]
  PastaNoodleBread  PastaNoodleBread[]
  PulseLegume       PulseLegume[]
  OilFat            OilFat[]
  SpiceMasala       SpiceMasala[]
  CondimentSauce    CondimentSauce[]
  CannedJarGood     CannedJarGood[]
  Sweetener         Sweetener[]
  SnackMisc         SnackMisc[]
  FrozenItem        FrozenItem[]
  HerbAromatic      HerbAromatic[]
}

model userRecipes {
  id              Int      @id @default(autoincrement())
  createdBy       User     @relation(fields: [userId], references: [id])
  userId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  recipeName      String
  servings        String
  description     String
  ingredients     String[] // Array of ingredient strings
  procedure       String
  estimatedTime   String
  calories        String
  nutritionalInfo Json
  vegan           Boolean
  categories      String[]
}

model Vegetable {
  id               Int             @id @default(autoincrement())
  name             String
  slug             String          @unique
  defaultUnit      String? // e.g. "g", "pcs", "cup"
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  UserIngredient   UserIngredient? @relation(fields: [userIngredientId], references: [id])
  userIngredientId Int?
}

